# URL du projet Supabase.
# Supabase > Project Settings > API > Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Clé publishable (publique), utilisable côté navigateur et côté serveur.
# Supabase > Project Settings > API Keys > Publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé secrète : accès complet qui contourne la RLS.
# NE JAMAIS l'exposer côté client (pas de préfixe NEXT_PUBLIC_, pas d'import dans un composant client).
# Supabase > Project Settings > API Keys > Secret key.
SUPABASE_SECRET_KEY=

# Chaîne de connexion Postgres (migrations, outils CLI).
# Supabase > Connect > Connection string (Session pooler).
DATABASE_URL=
